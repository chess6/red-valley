{
  "mcpServers": {
    "blender": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        "${HOME}/Dev/red-valley/tools/blender_mcp/mcp",
        "run",
        "blender-mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    }
  }
}